# Copy to .env.local for local overrides. On Vercel set these as Environment Variables.
# Address of the deployed relay (Cloudflare Worker). Default for local dev is http://localhost:8787
VITE_RELAY_URL=https://jab-relay.YOUR-SUBDOMAIN.workers.dev
# Only needed if the laptop page is opened on a LAN address but the phone must open a public one
# VITE_PUBLIC_ORIGIN=https://yourname.tech
